# KOGNOS v0.4 — Supabase: project URL and publishable key are safe for browsers.
# These two values were supplied for this Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://ktjdlvojnunjntwyodot.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Tp3iPHoHWnnmMUuwPxnf-A_skSnkCuq

# @supabase/server — ONLY in the Node.js server. Never prefix NEXT_PUBLIC_.
SUPABASE_URL=https://ktjdlvojnunjntwyodot.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Tp3iPHoHWnnmMUuwPxnf-A_skSnkCuq
# Masked/truncated values cannot work. Copy the FULL key directly from Supabase dashboard
# into apps/web/.env.local on your PC. Never publish it.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://ktjdlvojnunjntwyodot.supabase.co/auth/v1/.well-known/jwks.json

# NVIDIA API Catalog — OPTIONAL, used only after AI_FREE_ONLY=false (paid/SaaS mode).
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

AI_MAX_INPUT_CHARS=3000

# Development mode — enabled by default even when omitted.
# In this mode the application NEVER calls OpenAI or NVIDIA and ignores
# old AI_TUTOR_PROVIDER=openai settings. API keys remain server-side.
# Use keys from FREE-TIER Groq and/or Google AI Studio projects.
# For future billed SaaS deployment only, opt in explicitly with AI_FREE_ONLY=false.
AI_FREE_ONLY=true

# Shared per-account daily AI budget (tutor, questions and course development).
# Cap is enforced in PostgreSQL before calling the tutor model.
TUTOR_DAILY_REQUEST_LIMIT=30

# External PhET HTML5 simulations (CC BY-NC 4.0): development localhost is enabled.
# Production defaults to OFF. Only enable in a confirmed NON-COMMERCIAL project
# (no subscriptions, advertising or other commercial advantage).
# Any commercial use requires a separate PhET license: https://phet.colorado.edu/en/licensing
# Iframes load only after each student explicitly clicks "Carregar simulação".
# NEXT_PUBLIC_PHET_MODE=noncommercial-confirmed

# Multi-provider AI — add private keys to apps/web/.env.local only.
# Default: Groq 120B generation, Gemini 3.1 Flash-Lite independent review + Kog.
# Rate-limit fallback uses Gemini 2.5 Flash for generation, Groq 20B for review
# and Groq Llama 3.1 8B Instant for the tutor; no paid OpenAI key needed.
# Free-tier model eligibility does not imply unlimited quota or free usage
# if your provider project is on a PAID tier.
GROQ_API_KEY=
GEMINI_API_KEY=
AI_GENERATE_PROVIDER=groq
AI_GENERATE_MODEL=openai/gpt-oss-120b
AI_REVIEW_PROVIDER=gemini
AI_REVIEW_MODEL=gemini-3.1-flash-lite
AI_TUTOR_PROVIDER=gemini
AI_TUTOR_MODEL=gemini-3.1-flash-lite

# Automatic review recovery: if Gemini returns a temporary 5xx error,
# the backend retries the SAME review prompt ONCE using Groq GPT-OSS 20B.
# No unreviewed question is approved or stored.
# Set AI_REVIEW_FALLBACK_PROVIDER=none to disable automatic fallback.
AI_REVIEW_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional future paid/SaaS integration — ignored in default free-only mode.
# Never put this key under NEXT_PUBLIC_ or commit a real .env.local.
OPENAI_API_KEY=

{
  "name": "kognos-platform",
  "version": "0.8.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/education-engine"
  ],
  "scripts": {
    "dev": "npm --workspace @kognos/web run dev",
    "build": "npm --workspace @kognos/web run build",
    "start": "npm --workspace @kognos/web run start",
    "lint": "npm --workspace @kognos/web run lint",
    "test": "node --test packages/education-engine/test/*.test.mjs && node --experimental-strip-types --test apps/web/src/lib/*.test.ts",
    "typecheck": "npm --workspace @kognos/web exec tsc --noEmit",
    "test:design": "node --test tests/*.test.mjs"
  }
}